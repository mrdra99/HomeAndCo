# Copia in .env.local (non committare). Tutte le variabili sono opzionali.

# Dominio del nuovo sito (da scegliere con il cliente). Aggiorna canonical, sitemap, social e dati strutturati.
# Impostare prima della build di pubblicazione. In assenza usa il riferimento in content/settings.json.
# NEXT_PUBLIC_SITE_URL=https://www.dominio-scelto.it

# Sorgente dei contenuti: "file" (JSON in /content, default). "api" e "cms" non sono ancora implementate.
NEXT_PUBLIC_CONTENT_SOURCE=file

# Invio del form contatti: "formspree" per inviare, "disabled" per il collegamento email.
# In produzione senza configurazione usa "disabled". "mock" è una prova dichiarata, senza invio.
NEXT_PUBLIC_CONTACT_ADAPTER=disabled

# Crea un modulo nel tuo account Formspree e verifica l'email destinataria.
# Imposta entrambe le variabili in Cloudflare PRIMA della build e ripubblica.
# NEXT_PUBLIC_CONTACT_ADAPTER=formspree
# NEXT_PUBLIC_FORMSPREE_URL=https://formspree.io/f/xxxxxxxx
# L'endpoint è pubblico; password SMTP e chiavi private non vanno in NEXT_PUBLIC_*.
