# Copia in .env.local (non committare). Tutte le variabili sono opzionali.

# Sorgente dei contenuti: "file" (JSON in /content, default). "api" e "cms" non sono ancora implementate.
NEXT_PUBLIC_CONTENT_SOURCE=file

# Invio del form contatti: "mock" (default, simula l'invio). "formspree" e "api" sono stub commentati in lib/contact/adapter.ts.
NEXT_PUBLIC_CONTACT_ADAPTER=mock

# Solo quando si attivano gli adapter corrispondenti (oggi non letti dal codice attivo):
# NEXT_PUBLIC_FORMSPREE_URL=https://formspree.io/f/xxxxxxxx
# NEXT_PUBLIC_API_URL=https://api.home-co.it
